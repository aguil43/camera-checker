# ==========================================
# Configuración de Base de Datos
# ==========================================
DB_PATH=data/camera_checker.db

# ==========================================
# Configuración del Servidor SMTP (Correo)
# ==========================================
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_USER=alertas@tudominio.com
SMTP_PASSWORD=tu_contrasena_o_app_password
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Remitente y Destinatarios
EMAIL_FROM="Monitor de Cámaras" <alertas@tudominio.com>
EMAIL_TO=admin@tudominio.com,soporte@tudominio.com

# ==========================================
# Configuración de Navegación y Chequeo
# (Ajustados para cámaras con hardware/conexión lenta)
# ==========================================
BROWSER_HEADLESS=True
BROWSER_TIMEOUT_MS=60000
PAGE_LOAD_TIMEOUT_MS=60000
ELEMENT_WAIT_TIMEOUT_MS=30000
SEARCH_WAIT_TIMEOUT_MS=75000
SCREENSHOT_DIR=data/screenshots
CHECK_INTERVAL_HOURS=24
COOLDOWN_ALERT_HOURS=4
